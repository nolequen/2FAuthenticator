{
  "compilerOptions": {
    "lib": ["ES2020.Promise", "es6", "dom"],
    "target": "es6",
    "strict": true,
    "module": "es2015",
    "rootDir": "src",
    "moduleResolution": "node",
    "outDir": "build",
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "pretty": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "vue-draggable-plus": ["./src/definitions/vue-draggable-plus.d.ts"],
    },
  },
  "include": [
    "src/*.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
